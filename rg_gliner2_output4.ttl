        wp:RG_10506853-6_-_other ;
    wp:rg_Originaltext "Misnen. || capel. b. Marie in Rosis noviter erecta in Antiqua Civitate M.:  de indulg. 26. aug. 1441 S 376 3vs."@la,
        "Misnen. || vicarii et beneficiati eccl. M. quib. quond. Nicolaus Ziegenbock ep. Misnen. conc. ut (sicut cann. prebend. d. eccl.) mediam partem red. in testamento delegare val.:  eccl. Misnen. reparatione indigens, ab hereticis Bohemie oppressa (Frederico, Sigismundo et Ott(h)one germanis Saxonie ducibus ac marchionibus Misnen. etc. supplic.): de indulg. ad 7 an. 1. iun. 35 S 311 298vs, de ref. 31. decb. 1435 S 316 276vs."@la,
        "Misnen. || vicarii et beneficiati eccl. M. quib. quond. Nicolaus Ziegenbock ep. Misnen. conc. ut (sicut cann. prebend. d. eccl.) mediam partem red. in testamento delegare val.:  que in guerris contra hereticos Bohemos gravia damna perpessa est (Frederico, Sigismundo et Ottone fratribus germanis ducibus Saxonie marchionibus Misnen. supplic., quorum progenitores d. eccl. fundaverunt et dotaverunt): de indulg. plenaria ad 5 an. quocumque temp. (conc. de 7 an. in 2 festivitatibus) 15. mai. 36 S 322 70v, de ref. (conc. de 100 diebus in octavis) 15. mai. 36 S 322 70vs, de ref. (conc. de alia festivitate) 15. mai. 1436 S 322 71r."@la .

wp:RG_10507372 a wp:Regest,
        owl:NamedIndividual ;
    rdfs:label "RG 10507372"@de ;
    wp:hat_Bestandteil_RG wp:RG_10507372-0,
        wp:RG_10507372-4_-_benefice-provision ;
    wp:rg_Originaltext "Nuemburg. 	 Nuemburg. || magistricivium, consules et cives civit. N., qui ex devotione quandam capel. b. Marie in par. eccl. s. Venzeslai Nuemburg. (in qua duobus diebus septimane in magno numero ad audiendum missam conveniunt) ex lic. ordin. erigerunt et dotaverunt copiose:  par. eccl. s. Wentzeslai N. que plus quam 4000 communicantium habet: de indulg. 10. sept. 1440 S 367 130v."@la .

wp:RG_10507397 a wp:Regest,
        owl:NamedIndividual ;

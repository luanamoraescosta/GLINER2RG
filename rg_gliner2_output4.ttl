wp:RG_10506853-4_-_benefice-provision a wp:Sublemma_RG,
        owl:NamedIndividual ;
    rdfs:label "RG 10506853-4 - benefice provision"@de ;
    wp:has_RG_ID_Sublemma "10506853-4"^^xsd:string ;
    wp:hat_Weitere_Aktivitaet wp:Gnadenerweis_RG_10506853-4_benefice-provision ;
    wp:rg_Originaltext "vicarii et beneficiati eccl. M. quib. quond. Nicolaus Ziegenbock ep. Misnen. conc. ut (sicut cann. prebend. d. eccl.) mediam partem red. in testamento delegare val.:  que in guerris contra hereticos Bohemos gravia damna perpessa est (Frederico, Sigismundo et Ottone fratribus germanis ducibus Saxonie marchionibus Misnen. supplic., quorum progenitores d. eccl. fundaverunt et dotaverunt): de indulg. plenaria ad 5 an. quocumque temp. (conc. de 7 an. in 2 festivitatibus) 15. mai. 36 S 322 70v, de ref. (conc. de 100 diebus in octavis) 15. mai. 36 S 322 70vs, de ref. (conc. de alia festivitate) 15. mai. 1436 S 322 71r."@la ;
    wp:stringInRG "vicarii et beneficiati eccl. M. quib. quond. Nicolaus Ziegenbock ep. Misnen. conc. ut (sicut cann. prebend. d. eccl.) mediam partem red. in testamento delegare val.:  que in guerris contra hereticos Bohemos gravia damna perpessa est (Frederico, Sigismundo et Ottone fratribus germanis ducibus Saxonie marchionibus Misnen. supplic., quorum progenitores d. eccl. fundaverunt et dotaverunt): de indulg. plenaria ad 5 an. quocumque temp. (conc. de 7 an. in 2 festivitatibus) 15. mai. 36 S 322 70v, de ref. (conc. de 100 diebus in octavis) 15. mai. 36 S 322 70vs, de ref. (conc. de alia festivitate) 15. mai. 1436 S 322 71r."@la .


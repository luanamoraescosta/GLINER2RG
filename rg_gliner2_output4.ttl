    wp:hat_Nummer 10508486 ;
    wp:rg_Originaltext "Sunden. Zwerin. dioc. || eccl. b. Marie in op. S., ad quam multitudo christianorum confluit et que propter solemnitatem constructionis n. modicum indebitata est, campanili nondum completo:  de indulg. 28. apr. 42 S 382 51v, de uberioribus indulg. quia paup. est et magna indiget reformatione 11. iul. 1442 S 384 47v, L 387 246rs."@la,
        "Sunden. Zwerin. dioc. || par. eccl. s. Nicolai in op. S.:  de indulg. 26. mai. 1445 S 405 283v."@la .

wp:RG_10508513 a wp:Regest,
        owl:NamedIndividual ;
    rdfs:label "RG 10508513"@de ;

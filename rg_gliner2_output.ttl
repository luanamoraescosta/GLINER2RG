wp:RG_10200370-1_-_benefice-provision a wp:Sublemma_RG,
        owl:NamedIndividual ;
    rdfs:label "RG 10200370-1 - benefice provision"@de ;
    wp:has_RG_ID_Sublemma "10200370-1"^^xsd:string ;
    wp:hat_Weitere_Aktivitaet wp:Gnadenerweis_RG_10200370-1_benefice-provision ;
    wp:rg_Originaltext "conc. [concedere / concessio] indulg. [indulgentia / indulgere] iubilei visitantibus eccl. [ecclesia] mai. [maius / maior], domum fr. [frater] herem. [heremita] s. Aug. [anctus Augustinus] Magdeburg. [Magdeburgensis], eccl. [ecclesia] s. Johannis in Monte e. m. [extra muros] Magdeburg. [Magdeburgensis], eccl. [ecclesia] ss. [sancti [Plural, maskulin]] Petri et Pauli in antiqua civ. [civis / civitas] Magdeburg. [Magdeburgensis], (oblationum abbati mon. [monasterium / selten: monachus] s. Petri de Percipiano o. [obitus / ordo] s. [ordo sancte/ sancti] Ben. [ordo sancti Benedicti] Terdon. dioc. [diocesis] nuntio et Bartholomeo de Turchiis civi Lucan. assignatarum medietas in fabricam basilicarum urbis convertatur, altera medietas in fabricam  d. [dictus / dies / datum / dominus] eccl. [ecclesia] Magdeburg. [Magdeburgensis]) 26 apr. [aprilis] 1394 L 1 103v et V 314 236v."@la ;
    wp:stringInRG "conc. [concedere / concessio] indulg. [indulgentia / indulgere] iubilei visitantibus eccl. [ecclesia] mai. [maius / maior], domum fr. [frater] herem. [heremita] s. Aug. [anctus Augustinus] Magdeburg. [Magdeburgensis], eccl. [ecclesia] s. Johannis in Monte e. m. [extra muros] Magdeburg. [Magdeburgensis], eccl. [ecclesia] ss. [sancti [Plural, maskulin]] Petri et Pauli in antiqua civ. [civis / civitas] Magdeburg. [Magdeburgensis], (oblationum abbati mon. [monasterium / selten: monachus] s. Petri de Percipiano o. [obitus / ordo] s. [ordo sancte/ sancti] Ben. [ordo sancti Benedicti] Terdon. dioc. [diocesis] nuntio et Bartholomeo de Turchiis civi Lucan. assignatarum medietas in fabricam basilicarum urbis convertatur, altera medietas in fabricam  d. [dictus / dies / datum / dominus] eccl. [ecclesia] Magdeburg. [Magdeburgensis]) 26 apr. [aprilis] 1394 L 1 103v et V 314 236v."@la .


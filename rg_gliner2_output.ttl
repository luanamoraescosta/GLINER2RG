wp:RG_10501601 a wp:Regest,
        owl:NamedIndividual ;
    rdfs:label "RG 10501601"@de ;
    wp:hat_Bestandteil_RG wp:RG_10501601-0,
        wp:RG_10501601-1_-_Ablass,
        wp:RG_10501601-2_-_licence-licentia ;
    wp:hat_Nummer 10501601 ;
    wp:rg_Originaltext "Eberstorff (Ebirstorf) Misnen. [Misnensis] dioc. [diocesis] || par. [parochialis / parentes] eccl. [parochialis ecclesia] b. Marie in E., ad quam propter plurima miracula ibi operata multitudo confluit et que a principibus et nob. [nobilis] et habitatoribus partium illarum manu forti ab hereticis regni Bohemie vicini defenditur (Frederico duce Saxonie et marchione Misnen. [Misnensis] ac electore S.R.I. supplic. [supplicare / supplicatio]):  ad quam propter plurima miracula ingens multitudo etiam Bohemorum noviter ad fidem reductorum confluit (Frederico duce Saxonie et marchione Misnen. [Misnensis] ac Catherina eius matre ducissa Saxonie necnon rectore par. [parochialis / parentes] eccl. [parochialis ecclesia] in E. supplic. [supplicare / supplicatio]): de indulg. [indulgentia / indulgere] et de lic. quod ipse rector sec. [secularis] presbb. pro audiendis confess. [confessio / confessionale / confessor] delegare possit 21. febr. [februarius] 1437 S 332 114rs, L 347 29v."@la,
        "Eberstorff (Ebirstorf) Misnen. [Misnensis] dioc. [diocesis] || par. [parochialis / parentes] eccl. [parochialis ecclesia] b. Marie in E., ad quam propter plurima miracula ibi operata multitudo confluit et que a principibus et nob. [nobilis] et habitatoribus partium illarum manu forti ab hereticis regni Bohemie vicini defenditur (Frederico duce Saxonie et marchione Misnen. [Misnensis] ac electore S.R.I. supplic. [supplicare / supplicatio]):  de indulg. [indulgentia / indulgere] 23. mart. [martius / martir/ martyr] 1435 S 303 189r."@la .

wp:RG_10501954 a wp:Regest,
        owl:NamedIndividual ;
    rdfs:label "RG 10501954"@de ;
    wp:hat_Bestandteil_RG wp:RG_10501954-0,
        wp:RG_10501954-5_-_benefice-provision ;
    wp:rg_Originaltext "Fredericus dux Saxonie et marchio Misnen. [Misnensis], lantgravius Thuringie  et Sigismundus dux Saxonie et marchio modernus Misnen. [Misnensis] ac capit. [capitulum / capitularis] colleg. [collegium / collegiatus] eccl. [collegiata ecclesia] s. [sanctus / sine / sub] Georgii in castro Aldenburg Nuemburg. [Nuemburgensis] dioc. [diocesis], cuius mense capitul. (200 m. [mandare / mandatum / marca] arg. [marca argenti] p. [marca argenti puri]) olim quond. [quondam] Wilhelmus marchio Misnen. [Misnensis] predium nonnullorum mansorum in Aldenburg ac allodia c. pertinentiis et par. [parochialis / parentes] eccll. in Elsterberg, Kale, Ffroberg, Koryn, Gotznitz, Borgwerbin, Lugkaw, Hinna, Czeegerucke et Luben Magunt. [Maguntinensis], Halberstad. [Halberstadensis] et Nuemburg. [Nuemburgensis] dioc. [diocesis] (insimul 60 m. [mandare / mandatum / marca] arg. [marca argenti] p. [marca argenti puri]), quarum ius patron. [patronatus / patronus] ad d. marchionem pertinebat, donavit, incorp. [incorporare / incorporatio] a Johanne XXIII. et Nicolao de Lubich ep. [episcopus] Merseburg. [Merseburgensis] approbata || et Sigismundus ac Otto fratres germani Saxonie duces et marchiones Misnen. [Misnensis] omnes lantgravii Thuringie, qui occasione heresis Bohemorum gravia dampna sustulerunt: de indulg. [indulgentia / indulgere] pro eccl. [ecclesia] Misnen. [Misnensis] ab eorum progenitoribus fund. [fundare / fundatio / fundator] (conc. [concedere / concessio] de 7 an. [annus] in 2 festivitatibus perpetuo) 20. decb. [december] 1435 S 316 262v."@la .


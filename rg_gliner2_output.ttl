    wp:rg_Originaltext "par. [parochialis / parentes] eccl. [parochialis ecclesia] b. Marie in E., ad quam propter plurima miracula ibi operata multitudo confluit et que a principibus et nob. [nobilis] et habitatoribus partium illarum manu forti ab hereticis regni Bohemie vicini defenditur (Frederico duce Saxonie et marchione Misnen. [Misnensis] ac electore S.R.I. supplic. [supplicare / supplicatio]):  ad quam propter plurima miracula ingens multitudo etiam Bohemorum noviter ad fidem reductorum confluit (Frederico duce Saxonie et marchione Misnen. [Misnensis] ac Catherina eius matre ducissa Saxonie necnon rectore par. [parochialis / parentes] eccl. [parochialis ecclesia] in E. supplic. [supplicare / supplicatio]): de indulg. [indulgentia / indulgere] et de lic. quod ipse rector sec. [secularis] presbb. pro audiendis confess. [confessio / confessionale / confessor] delegare possit 21. febr. [februarius] 1437 S 332 114rs, L 347 29v."@la ;
    wp:stringInRG "par. [parochialis / parentes] eccl. [parochialis ecclesia] b. Marie in E., ad quam propter plurima miracula ibi operata multitudo confluit et que a principibus et nob. [nobilis] et habitatoribus partium illarum manu forti ab hereticis regni Bohemie vicini defenditur (Frederico duce Saxonie et marchione Misnen. [Misnensis] ac electore S.R.I. supplic. [supplicare / supplicatio]):  ad quam propter plurima miracula ingens multitudo etiam Bohemorum noviter ad fidem reductorum confluit (Frederico duce Saxonie et marchione Misnen. [Misnensis] ac Catherina eius matre ducissa Saxonie necnon rectore par. [parochialis / parentes] eccl. [parochialis ecclesia] in E. supplic. [supplicare / supplicatio]): de indulg. [indulgentia / indulgere] et de lic. quod ipse rector sec. [secularis] presbb. pro audiendis confess. [confessio / confessionale / confessor] delegare possit 21. febr. [februarius] 1437 S 332 114rs, L 347 29v."@la .

wp:RG_10501954-0 a wp:Header_RG,
        owl:NamedIndividual ;
    rdfs:label "RG 10501954-0"@de ;
    wp:has_RG_ID_Header "10501954-0"^^xsd:string ;
    wp:rg_Originaltext "Fredericus dux Saxonie et marchio Misnen. [Misnensis], lantgravius Thuringie  et Sigismundus dux Saxonie et marchio modernus Misnen. [Misnensis] ac capit. [capitulum / capitularis] colleg. [collegium / collegiatus] eccl. [collegiata ecclesia] s. [sanctus / sine / sub] Georgii in castro Aldenburg Nuemburg. [Nuemburgensis] dioc. [diocesis], cuius mense capitul. (200 m. [mandare / mandatum / marca] arg. [marca argenti] p. [marca argenti puri]) olim quond. [quondam] Wilhelmus marchio Misnen. [Misnensis] predium nonnullorum mansorum in Aldenburg ac allodia c. pertinentiis et par. [parochialis / parentes] eccll. in Elsterberg, Kale, Ffroberg, Koryn, Gotznitz, Borgwerbin, Lugkaw, Hinna, Czeegerucke et Luben Magunt. [Maguntinensis], Halberstad. [Halberstadensis] et Nuemburg. [Nuemburgensis] dioc. [diocesis] (insimul 60 m. [mandare / mandatum / marca] arg. [marca argenti] p. [marca argenti puri]), quarum ius patron. [patronatus / patronus] ad d. marchionem pertinebat, donavit, incorp. [incorporare / incorporatio] a Johanne XXIII. et Nicolao de Lubich ep. [episcopus] Merseburg. [Merseburgensis] approbata"@la .

wp:RG_10501954-5_-_benefice-provision a wp:Sublemma_RG,
        owl:NamedIndividual ;
    rdfs:label "RG 10501954-5 - benefice provision"@de ;
    wp:has_RG_ID_Sublemma "10501954-5"^^xsd:string ;
    wp:hat_Weitere_Aktivitaet wp:Gnadenerweis_RG_10501954-5_benefice-provision ;
    wp:rg_Originaltext "et Sigismundus ac Otto fratres germani Saxonie duces et marchiones Misnen. [Misnensis] omnes lantgravii Thuringie, qui occasione heresis Bohemorum gravia dampna sustulerunt: de indulg. [indulgentia / indulgere] pro eccl. [ecclesia] Misnen. [Misnensis] ab eorum progenitoribus fund. [fundare / fundatio / fundator] (conc. [concedere / concessio] de 7 an. [annus] in 2 festivitatibus perpetuo) 20. decb. [december] 1435 S 316 262v."@la ;
    wp:stringInRG "et Sigismundus ac Otto fratres germani Saxonie duces et marchiones Misnen. [Misnensis] omnes lantgravii Thuringie, qui occasione heresis Bohemorum gravia dampna sustulerunt: de indulg. [indulgentia / indulgere] pro eccl. [ecclesia] Misnen. [Misnensis] ab eorum progenitoribus fund. [fundare / fundatio / fundator] (conc. [concedere / concessio] de 7 an. [annus] in 2 festivitatibus perpetuo) 20. decb. [december] 1435 S 316 262v."@la .


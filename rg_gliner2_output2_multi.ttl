wp:RG_10509465-1_-_Ablass a wp:Sublemma_RG,
        owl:NamedIndividual ;
    rdfs:label "RG 10509465-1 - Ablass"@de ;
    wp:erwaehnte_Entitaet wp:Carolus_IV_RI_Person ;
    wp:has_RG_ID_Sublemma "10509465-1"^^xsd:string ;
    wp:hat_Ort wp:Havelberg_Ort ;
    wp:hat_Zentrale_Aktivitaet wp:Ablass_RG_10509465_1_\(RG_10509465-1\) ;
    wp:rg_Originaltext "locus W. sub dominio Frederici II. marchionis Brandenburg. [Brandenburgensis] (supplic. [supplicare / supplicatio]), in cuius par. [parochialis / parentes] eccl. [parochialis ecclesia] ante 60 an. totaliter combusta 3 hostie consecrate reperte sunt transformate (sanguine resperso), ad quas hostias magnus numerus peregrinorum (inter quos Carolus IV. R.I., reges Francie, Anglie et Bohemie et alii principes) confluxit sicut et confluit, quod miraculum et aep. [archiepiscopus] Magdeburg. [Magdeburgensis] metropolitanus et ep. Havelberg. [Havelbergensis] c. multis aliis epp. [episcopi [Plural]] approbaverunt et indulg. [indulgentia / indulgere] diversas conc. [concedere / concessio], ex quo d. [dictus / dies / datum / dominus] eccl. solemniter reedificata et cultus inibi sumptuose restauratus est:  indulg. [indulgentia / indulgere] et facult. [facultas] audiendi confess. [confessio / confessionale / confessor] pro rect. [rector] d. [dictus / dies / datum / dominus] par. [parochialis / parentes] eccl. [parochialis ecclesia] et 2 capp. 2. ian. [ianuarius] 1447 V 365 475rss."@la ;
    wp:stringInRG "locus W. sub dominio Frederici II. marchionis Brandenburg. [Brandenburgensis] (supplic. [supplicare / supplicatio]), in cuius par. [parochialis / parentes] eccl. [parochialis ecclesia] ante 60 an. totaliter combusta 3 hostie consecrate reperte sunt transformate (sanguine resperso), ad quas hostias magnus numerus peregrinorum (inter quos Carolus IV. R.I., reges Francie, Anglie et Bohemie et alii principes) confluxit sicut et confluit, quod miraculum et aep. [archiepiscopus] Magdeburg. [Magdeburgensis] metropolitanus et ep. Havelberg. [Havelbergensis] c. multis aliis epp. [episcopi [Plural]] approbaverunt et indulg. [indulgentia / indulgere] diversas conc. [concedere / concessio], ex quo d. [dictus / dies / datum / dominus] eccl. solemniter reedificata et cultus inibi sumptuose restauratus est:  indulg. [indulgentia / indulgere] et facult. [facultas] audiendi confess. [confessio / confessionale / confessor] pro rect. [rector] d. [dictus / dies / datum / dominus] par. [parochialis / parentes] eccl. [parochialis ecclesia] et 2 capp. 2. ian. [ianuarius] 1447 V 365 475rss."@la .


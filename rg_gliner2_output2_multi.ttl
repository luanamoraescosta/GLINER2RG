wp:Ablass_RG_10403100_8_\(RG_10403100-8\) a wp:Ablass,
        wp:Ad-instar-Ablass,
        owl:NamedIndividual ;
    rdfs:label "Ablass (RG 10403100-8)"@de ;
    wp:rg_Originaltext "de indulg. [indulgentia / indulgere] pro par. [parochialis / parentes] eccl. [parochialis ecclesia] in op. [opidum, oppidum] Mitteweydis Misnen. [Misnensis] dioc.; pro par. [parochialis / parentes] eccl. [parochialis ecclesia] s. [sanctus / sine / sub] Jacobi in op. [opidum, oppidum] Kempnicen. d. [dictus / dies / datum / dominus] dioc.; pro eccl. b. [beatus / bulla] Marie v. [virgo / vide, vel] e. op. [opidum, oppidum] Githan Merseburg. [Merseburgensis] dioc.; mort. [mortis [u. a. [argentum / annus] Deklinationsformen von mors]] artic. [mortis articulus/ in mortis articulo] pro Henrico Lukaw vic. [vicarius] in castro Aldenburg Nuemburg. [Nuemburgensis] dioc. [diocesis] 3 dec. [decanus / december] 1421 S 158 73."@la ;
    skos:definition "Zentrale Aktivität in RG 10403100-8"^^xsd:string .

wp:Ablass_RG_10405759_1_\(RG_10405759-1\) a wp:Ablass,
        wp:Ad-instar-Ablass,
        owl:NamedIndividual ;
    rdfs:label "Ablass (RG 10405759-1)"@de ;
    wp:rg_Originaltext "capella b. [beatus / bulla] Marie ville H. Halberstad. [Halberstadensis] dioc. [diocesis] que est unita mon. [monasterium / selten: monachus] monial. [monialis] in Niendorpe o. [obitus / ordo] Cist. [ordo Cisterciensis] :   indulg. [indulgentia / indulgere] 18 oct. [october] 1429 L 285 296v."@la ;
    skos:definition "Zentrale Aktivität in RG 10405759-1"^^xsd:string .

wp:Ablass_RG_10410537_1_\(RG_10410537-1\) a wp:Ablass,
        wp:Ad-instar-Ablass,
        owl:NamedIndividual ;
    rdfs:label "Ablass (RG 10410537-1)"@de ;
    wp:rg_Originaltext "mon. [monasterium / selten: monachus] Marie v. [virgo / vide, vel] et Birgitte Reval. [Revaliensis] dioc. [diocesis] ac mon. [monasterium / selten: monachus] in Mariewold Razeburg. [Razeburgensis] dioc.:    de indulg. [indulgentia / indulgere] 7 apr. [aprilis] 1418 S 110 197v."@la ;
    skos:definition "Zentrale Aktivität in RG 10410537-1"^^xsd:string .


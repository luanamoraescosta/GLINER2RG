wp:Gnadenerweis_RG_10414862-4_privilege-mandate a wp:Gnadenerweis,
        owl:NamedIndividual ;
    rdfs:label "Privilege Mandate (RG 10414862-4)"@de ;
    wp:rg_Originaltext "de indulg. [indulgentia / indulgere] pro colleg. [collegium / collegiatus] eccl. [collegiata ecclesia] s. Georgii in castro Aldenburg Nuemburg. [Nuemburgensis] dioc. [diocesis], fac. [facere / facultas] absol. [absolvere / absolutio] in casibus reserv. [reservare / reservatio] pro prep. [prepositus], esu carnium pro abb. [abbas] etc. [abbas et conventus] o. [obitus / ordo] s. [ordo sancte/ sancti] Ben. [ordo sancti Benedicti] et C. in hospitio d. marchionis, conserv. [conservare / conservator / (littera) conservatoria] pro suprad. [supradictus] eccl., iure conferendi can. [canonicatus / canonicus / canonissa] et preb. [canonicatus et prebenda] in eccl. Nuemburg. [Nuemburgensis] et in colleg. [collegium / collegiatus] eccl. [collegiata ecclesia] Citzen. d. dioc. [diocesis], quod prepos. [prepositatus / prepositura] colleg. [collegium / collegiatus] eccl. [collegiata ecclesia] in Aldenburg sit dignitas electiva 8 iul. [iulius] 1423 S 169 97v."@la ;
    skos:definition "Weitere Aktivität in RG 10414862-4 [privilege_mandate]"^^xsd:string .

wp:Gnadenerweis_RG_10414862-8_licence-licentia a wp:Erlaubnis_\(licentia\),
        owl:NamedIndividual ;
    rdfs:label "Licence Licentia (RG 10414862-8)"@de ;
    wp:rg_Originaltext "de lic. [licentia / licentiatus] facere celebrare in locis interd.; de esu carnium pro monachis o. [obitus / ordo] Cist. [ordo Cisterciensis] ad mensam suam venientibus; de indulg. [indulgentia / indulgere] pro eccl. [ecclesia] colleg. [collegiata ecclesia] in Aldenburg Merseburg. [Merseburgensis] (!) dioc.; de conf. [confirmare / confirmatio] indulg. [indulgentia / indulgere] etc. [et cetera] concessarum p. [per / parvus / purus / prebenda] Bonifatium IX pro eccl. [ecclesia] colleg. [collegiata ecclesia] b. [beatus / bulla] Marie in castro Aldenburg Nuemburg. [Nuemburgensis] (!) dioc. [diocesis] 30 dec. [decanus / december] 1424 S 182 191."@la ;
    skos:definition "Weitere Aktivität in RG 10414862-8 [licence_licentia]"^^xsd:string .

wp:Gnadenerweis_RG_10501601-2_licence-licentia a wp:Erlaubnis_\(licentia\),
        owl:NamedIndividual ;
    rdfs:label "Licence Licentia (RG 10501601-2)"@de ;
    wp:rg_Originaltext "par. [parochialis / parentes] eccl. [parochialis ecclesia] b. Marie in E., ad quam propter plurima miracula ibi operata multitudo confluit et que a principibus et nob. [nobilis] et habitatoribus partium illarum manu forti ab hereticis regni Bohemie vicini defenditur (Frederico duce Saxonie et marchione Misnen. [Misnensis] ac electore S.R.I. supplic. [supplicare / supplicatio]):  ad quam propter plurima miracula ingens multitudo etiam Bohemorum noviter ad fidem reductorum confluit (Frederico duce Saxonie et marchione Misnen. [Misnensis] ac Catherina eius matre ducissa Saxonie necnon rectore par. [parochialis / parentes] eccl. [parochialis ecclesia] in E. supplic. [supplicare / supplicatio]): de indulg. [indulgentia / indulgere] et de lic. quod ipse rector sec. [secularis] presbb. pro audiendis confess. [confessio / confessionale / confessor] delegare possit 21. febr. [februarius] 1437 S 332 114rs, L 347 29v."@la ;
    skos:definition "Weitere Aktivität in RG 10501601-2 [licence_licentia]"^^xsd:string .

wp:Gnadenerweis_RG_10501954-5_incorporation a wp:Gnadenerweis,
        owl:NamedIndividual ;
    rdfs:label "Incorporation (RG 10501954-5)"@de ;
    wp:rg_Originaltext "et Sigismundus ac Otto fratres germani Saxonie duces et marchiones Misnen. [Misnensis] omnes lantgravii Thuringie, qui occasione heresis Bohemorum gravia dampna sustulerunt: de indulg. [indulgentia / indulgere] pro eccl. [ecclesia] Misnen. [Misnensis] ab eorum progenitoribus fund. [fundare / fundatio / fundator] (conc. [concedere / concessio] de 7 an. [annus] in 2 festivitatibus perpetuo) 20. decb. [december] 1435 S 316 262v."@la ;
    skos:definition "Weitere Aktivität in RG 10501954-5 [incorporation]"^^xsd:string .

wp:Gnadenerweis_RG_10506853-3_benefice-provision a wp:Gnadenerweis,
        owl:NamedIndividual ;
    rdfs:label "Benefice Provision (RG 10506853-3)"@de ;
    wp:rg_Originaltext "vicarii et beneficiati eccl. [ecclesia] M. quib. [quibus] quond. [quondam] Nicolaus Ziegenbock ep. [episcopus] Misnen. [Misnensis] conc. [concedere / concessio] ut (sicut cann. prebend. [prebendatus] d. eccl. [ecclesia]) mediam partem red. [redditus] in testamento delegare val.:  eccl. [ecclesia] Misnen. [Misnensis] reparatione indigens, ab hereticis Bohemie oppressa (Frederico, Sigismundo et Ott(h)one germanis Saxonie ducibus ac marchionibus Misnen. [Misnensis] etc. [et cetera] supplic. [supplicare / supplicatio]): de indulg. [indulgentia / indulgere] ad 7 an. [annus] 1. iun. [iunior / iunius] 35 S 311 298vs, de ref. [reformare / reformatio] 31. decb. [december] 1435 S 316 276vs."@la ;
    skos:definition "Weitere Aktivität in RG 10506853-3 [benefice_provision]"^^xsd:string .

wp:Gnadenerweis_RG_10506853-4_benefice-provision a wp:Gnadenerweis,
        owl:NamedIndividual ;
    rdfs:label "Benefice Provision (RG 10506853-4)"@de ;
    wp:rg_Originaltext "vicarii et beneficiati eccl. [ecclesia] M. quib. [quibus] quond. [quondam] Nicolaus Ziegenbock ep. [episcopus] Misnen. [Misnensis] conc. [concedere / concessio] ut (sicut cann. prebend. [prebendatus] d. eccl. [ecclesia]) mediam partem red. [redditus] in testamento delegare val.:  que in guerris contra hereticos Bohemos gravia damna perpessa est (Frederico, Sigismundo et Ottone fratribus germanis ducibus Saxonie marchionibus Misnen. [Misnensis] supplic. [supplicare / supplicatio], quorum progenitores d. eccl. [ecclesia] fundaverunt et dotaverunt): de indulg. [indulgentia / indulgere] plenaria ad 5 an. [annus] quocumque temp. [tempus] (conc. [concedere / concessio] de 7 an. [annus] in 2 festivitatibus) 15. mai. [maius / maior] 36 S 322 70v, de ref. [reformare / reformatio] (conc. [concedere / concessio] de 100 diebus in octavis) 15. mai. [maius / maior] 36 S 322 70vs, de ref. [reformare / reformatio] (conc. [concedere / concessio] de alia festivitate) 15. mai. [maius / maior] 1436 S 322 71r."@la ;
    skos:definition "Weitere Aktivität in RG 10506853-4 [benefice_provision]"^^xsd:string .

wp:Gnadenerweis_RG_10507372-4_licence-licentia a wp:Erlaubnis_\(licentia\),
        owl:NamedIndividual ;
    rdfs:label "Licence Licentia (RG 10507372-4)"@de ;
    wp:rg_Originaltext "magistricivium, consules et cives civit. [civitas] N., qui ex devotione quandam capel. [capella] b. [beatus / bulla] Marie in par. [parochialis / parentes] eccl. [parochialis ecclesia] s. [sanctus / sine / sub] Venzeslai Nuemburg. [Nuemburgensis] (in qua duobus diebus septimane in magno numero ad audiendum missam conveniunt) ex lic. [licentia / licentiatus] ordin. [ordinarius / ordinare] erigerunt et dotaverunt copiose:  par. [parochialis / parentes] eccl. [parochialis ecclesia] s. [sanctus / sine / sub] Wentzeslai N. que plus quam 4000 communicantium habet: de indulg. [indulgentia / indulgere] 10. sept. [september] 1440 S 367 130v."@la ;
    skos:definition "Weitere Aktivität in RG 10507372-4 [licence_licentia]"^^xsd:string .

wp:Gnadenerweis_RG_10508486-1_benefice-provision a wp:Gnadenerweis,
        owl:NamedIndividual ;
    rdfs:label "Benefice Provision (RG 10508486-1)"@de ;
    wp:rg_Originaltext "eccl. [ecclesia] b. [beatus / bulla] Marie in op. [opidum, oppidum] S., ad quam multitudo christianorum confluit et que propter solemnitatem constructionis n. [non] modicum indebitata est, campanili nondum completo:  de indulg. [indulgentia / indulgere] 28. apr. [aprilis] 42 S 382 51v, de uberioribus indulg. [indulgentia / indulgere] quia paup. [pauper / paupertas] est et magna indiget reformatione 11. iul. [iulius] 1442 S 384 47v, L 387 246rs."@la ;
    skos:definition "Weitere Aktivität in RG 10508486-1 [benefice_provision]"^^xsd:string .

wp:Gnadenerweis_RG_10509557-1_benefice-provision a wp:Gnadenerweis,
        owl:NamedIndividual ;
    rdfs:label "Benefice Provision (RG 10509557-1)"@de ;
    wp:rg_Originaltext "capel. [capella] b. [beatus / bulla] Marie in villa Cz. sumptuose in suis edificiis incepta ac propter ipsius operis sumptuositatem nondum completa:  de indulg. [indulgentia / indulgere] 20. iul. [iulius] 1434 S 297 55rs, L 325 114v."@la ;
    skos:definition "Weitere Aktivität in RG 10509557-1 [benefice_provision]"^^xsd:string .

wp:Gnadenerweis_RG_10605322-2_privilege-mandate a wp:Gnadenerweis,
        owl:NamedIndividual ;
